{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline -n 20)",
      "Bash(git branch --show-current)",
      "Bash(node --check .claude/hooks/agent-allowlist.js)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(gh *)",
      "Bash(docker*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npx *)",
      "Bash(rm *)",
      "Bash(Remove-Item*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/.credentials.json)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.claude/**)",
      "Edit(settings*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-allowlist.js"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
